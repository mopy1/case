# Copiar este archivo a ".env" y completar con valores reales.
# ".env" esta en .gitignore: nunca debe commitearse.

# Contrasena del usuario de PostgreSQL (docker-compose)
POSTGRES_PASSWORD=changeme

# Origen permitido para CORS (frontend, cuando exista)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Clave de firma de los JWT (solo produccion, docker-compose.prod.yml la exige).
# Generar con: openssl rand -base64 48
# JWT_SECRET=   (dejar comentada en local: vacia rompe el arranque del backend)
